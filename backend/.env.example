# Lokal ishga tushirish uchun namuna. Nusxa oling: cp .env.example .env
# Hech qachon haqiqiy .env ni git'ga yoki ZIP'ga qo'shmang.
APP_ENV=development
SECRET_KEY=dev-only-secret-key-change-me-0000000000
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# REDIS_URL=redis://localhost:6379   # bo'sh bo'lsa xotiradagi Redis ishlatiladi (faqat dev)
JOB_MODE=inline
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=uzbiznesssbot
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_CHAT_ID=

# To'lovlar (bo'sh bo'lsa shu usul o'chiq)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
MANUAL_CARD_NUMBER=
MANUAL_CARD_HOLDER=
PLAN_CREDIT_PRICE_SOM=50000

# AI (ixtiyoriy; birorta kalit bo'lsa yoqiladi)
AI_ENABLED=true
AI_DAILY_TOKEN_BUDGET=2000000
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Muqova rasmini faoliyat turiga qarab avtomatik topish (https://www.pexels.com/api/ , bepul kalit)
PEXELS_API_KEY=

# Cloudflare R2 (production)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

SENTRY_DSN=
